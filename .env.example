# --- Application ---
APP_URL=http://localhost:3000
NODE_ENV=development
# Explicitly enables the source-event simulator outside production only.
ENABLE_DEV_SIMULATOR=false
# Local-only sign-in bypass for UI development. Guarded again by NODE_ENV === development in server code.
DEV_AUTH_BYPASS=false
DEV_AUTH_EMAIL=lead@trace.demo

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Security ---
# >= 32 random chars. Encrypts connector secrets (webhook secrets, OAuth tokens) at rest with AES-256-GCM.
SECRETS_ENCRYPTION_KEY=
# Bearer token for POST /api/jobs/run (invoke from cron every minute)
CRON_SECRET=

# --- Storage ---
# Local-disk adapter root (default: ./.data/storage). Swap adapter in src/server/storage.ts for S3/Supabase.
STORAGE_ROOT=

# --- GitHub (GitHub App or repository webhooks) ---
# Webhook secrets are generated per connection and encrypted; no global secret required.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# --- Onshape OAuth ---
ONSHAPE_CLIENT_ID=
ONSHAPE_CLIENT_SECRET=

# --- Chat capture connectors ---
# Telegram: per-connection secret token entered in the UI and used with setWebhook(secret_token=...)
# Discord: relay bot sends X-Trace-Webhook-Secret (generated per connection)
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# --- AI provider (optional; Evidence Core works without it) ---
# disabled | fake | openai-compatible
AI_PROVIDER=disabled
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- Billing (Stripe-compatible) ---
# Development-only fake plan changes require this explicit value. It is ignored in production.
BILLING_ADAPTER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CLUB=
STRIPE_PRICE_SCHOOL=

# --- Email (invitations / magic links; not required for local dev) ---
EMAIL_FROM=
RESEND_API_KEY=

# --- Observability ---
SENTRY_DSN=
