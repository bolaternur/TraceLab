# --- Application ---
APP_URL=http://localhost:3000
NODE_ENV=development
# Explicitly enables the source-event simulator outside production only.
ENABLE_DEV_SIMULATOR=false
# Legacy bypass is retired. All accounts require email verification.
DEV_AUTH_BYPASS=false
DEV_AUTH_EMAIL=lead@trace.demo

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://tracelab_runtime:CHANGE_ME@127.0.0.1:5432/tracelab_dev
# Optional: actual PostgreSQL role when the pooler login is role.project_ref.
# Migration grants verify SELECT current_user against this role, not the pooler suffix.
DATABASE_RUNTIME_ROLE=
# Migration owner only; never use this role in the running application.
DATABASE_MIGRATION_URL=postgresql://tracelab_owner:CHANGE_ME@127.0.0.1:5432/tracelab_dev

# --- Security ---
# >= 32 random chars. Encrypts connector secrets (webhook secrets, OAuth tokens) at rest with AES-256-GCM.
SECRETS_ENCRYPTION_KEY=
# Bearer token for POST /api/jobs/run (invoke from cron every minute)
CRON_SECRET=
# Enable only behind a trusted HTTPS proxy; block direct access to the app.
TRUST_PROXY=false
# Count verified trusted proxies from the right of X-Forwarded-For (1..5).
# Keep 1 until the deployed chain has been checked. Never trust its leftmost value blindly.
TRUST_PROXY_HOPS=1

# --- Storage ---
# local | supabase. Keep the bucket private. Changing this does NOT migrate old files.
STORAGE_PROVIDER=local
STORAGE_ROOT=./.data/storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# --- GitHub (GitHub App or repository webhooks) ---
# Webhook secrets are generated per connection and encrypted; no global secret required.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# --- Onshape OAuth ---
ONSHAPE_CLIENT_ID=
ONSHAPE_CLIENT_SECRET=

# --- Chat capture connectors ---
# Telegram: per-connection secret token entered in the UI and used with setWebhook(secret_token=...)
# Discord: relay bot sends X-Trace-Webhook-Secret (generated per connection)
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# --- AI provider (optional; Evidence Core works without it) ---
# disabled | fake | openai-compatible
AI_PROVIDER=disabled
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- Email verification and recovery ---
MAIL_TRANSPORT=local
MAIL_PREVIEW_ENABLED=true
MAIL_ENABLE_EXTERNAL_DELIVERY=false
MAIL_FROM=TraceLab <local@tracelab.test>
RESEND_API_KEY=

# --- Observability ---
SENTRY_DSN=
